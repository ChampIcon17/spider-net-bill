# backend/.env — do not commit

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8080

DATABASE_URL=postgresql://user:password@localhost:5432/spider_net_bill?schema=public

JWT_SECRET=change-me-use-at-least-32-characters-long
