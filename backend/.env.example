# Copy to backend/.env (never commit .env). Values are validated on boot (see src/config/configuration.ts).

NODE_ENV=development
PORT=3000
# CORS origin for the Vite app (no trailing slash)
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/spider_net_bill?schema=public

JWT_SECRET=change-me-use-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-another-32-char-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379

# M-Pesa Daraja (sandbox or production)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL Safaricom can POST to (use ngrok in local dev)
MPESA_CALLBACK_URL=https://your-public-host/mpesa/callback
MPESA_PHONE_PREFIX=254
# Comma-separated CIDRs allowed to hit webhook (empty = skip IP check)
DARAJA_ALLOWED_CIDRS=
DARAJA_WEBHOOK_SECRET=
# development only: skip webhook signature checks
# DARAJA_WEBHOOK_BYPASS=true

# MikroTik RouterOS API (set MIKROTIK_ENABLED=true when router is reachable)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASS=
MIKROTIK_PORT=8728
MIKROTIK_ENABLED=false
