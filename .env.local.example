# Copy to .env.local (never commit .env.local)
#
# Frontend API base URL — must match your backend origin (scheme + host + port).
# No trailing slash. Vite exposes this as import.meta.env.VITE_API_URL.
#
# Local NestJS (default PORT 3000):
VITE_API_URL=http://localhost:3000
#
# Deployed backend example:
# VITE_API_URL=https://your-backend.onrender.com
